# Tests of the portable modules on the PC (gcc from MSYS2 UCRT64, or any Unix cc)
#
#   make -f Makefile.host test

CC     ?= gcc
CFLAGS := -std=c99 -Wall -Wextra -pedantic -O1 -g -Isrc

OUT   := build/host/tests
SRCS  := src/http.c src/json.c src/fsmap.c src/tz.c src/session.c src/config.c src/auth.c \
         src/graph.c \
         tests/tests.c tests/test_http.c tests/test_json.c tests/test_fsmap.c tests/test_tz.c \
         tests/test_session.c tests/test_config.c tests/test_auth.c tests/test_graph.c \
         tests/fake_net.c tests/fake_plat.c
HDRS  := $(wildcard src/*.h tests/*.h)

test: $(OUT)
	./$(OUT)

$(OUT): $(SRCS) $(HDRS)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(SRCS) -o $@

clean:
	rm -rf build/host

.PHONY: test clean
